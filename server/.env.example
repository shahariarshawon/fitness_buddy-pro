# Fitness Buddy Pro — Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/fitnessBuddyPro

# Authentication
JWT_SECRET=super_secret_jwt_key_fitness_buddy_pro_2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_token_key_fitness_buddy_pro_2026
JWT_REFRESH_EXPIRES_IN=30d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional Cloudinary Configuration (Progress photo uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Assistant Settings (Optional API Key for live OpenAI/Gemini integration; built-in rule engine works out-of-the-box)
AI_API_KEY=
